with "config/sed_config.gpr";

--  Root project for the sed command-line stream editor.
--
--  src/library holds the whole Sed hierarchy; src/main holds only the thin
--  process entry point. The executable built from sed_main.adb is installed
--  under the name "sed". Message catalogues live under share/sed so that the
--  installed program resolves them relative to its own location and never
--  through the source tree.
project Sed is

   for Source_Dirs use ("src/library", "src/main", "config");
   for Object_Dir use "obj/" & Sed_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sed_main.adb");
   for Languages use ("Ada");

   package Builder is
      --  The installed program is named "sed"; the main unit cannot be, because
      --  Sed is the root package of the hierarchy.
      for Executable ("sed_main.adb") use "sed";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Sed_Config.Ada_Compiler_Switches &
        ("-gnat2022",
         "-gnatyM120",  --  Project maximum line length
         "-gnatwe");    --  Project-owned code must build warning-free
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts ("share/sed/messages") use ("share/sed/messages/catalog.txt");
   end Install;

end Sed;
