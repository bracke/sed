with "../sed.gpr";
with "aunit.gpr";
with "project_tools.gpr";
with "messages.gpr";
with "terminal_styles.gpr";

--  Test and tooling crate for sed.
--
--  Nothing here is reachable from the sed executable: the dependency runs one
--  way only, so AUnit, project_tools and every test helper stay out of the
--  production closure.
project Sed_Tests is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("sed_tests_main.adb", "sed_tools.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-gnatyM120", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Sed_Tests;
